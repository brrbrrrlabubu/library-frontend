# Base URL backend API. Do not add a trailing slash.
VITE_API_URL=http://localhost:8080/api
# true — local demo data persisted in browser; false — use real backend endpoints.
VITE_USE_MOCKS=true

# Public information shown on the home page and in the footer.
# The values below are demo placeholders — replace them with the real library
# details before deployment.
VITE_LIBRARY_ADDRESS=г. Бишкек, просп. Чуй 207
VITE_LIBRARY_HOURS=Пн–Пт 9:00–19:00, Сб 10:00–16:00, Вс — выходной
VITE_LIBRARY_CONTACT=+996 (312) 90-00-90 · info@library.local
